    // ── Old approach: Custom ListNode ──────────────────────────────────────────
    public class ListNode(int val = 0, ListNode? next = null)
    {
        public int val = val;
        public ListNode? next = next;
    }

    internal class Program
    {
        static ListNode AddTwoNumbers(ListNode l1, ListNode l2)
        {
            var dummy = new ListNode();
            var curr = dummy;
            int carry = 0;

            while (l1 != null || l2 != null || carry != 0)
            {
                int sum = (l1?.val ?? 0) + (l2?.val ?? 0) + carry;
                carry = sum / 10;
                curr.next = new ListNode(sum % 10);
                curr = curr.next;
                l1 = l1?.next!;
                l2 = l2?.next!;
            }

            return dummy.next!;
        }

        static void Print(ListNode node)
        {
            var vals = new List<int>();
            while (node != null) { vals.Add(node.val); node = node.next!; }
            Console.WriteLine("[" + string.Join(",", vals) + "]");
        }

        // ── New approach: Built-in LinkedList<T> ───────────────────────────────
        static LinkedList<int> AddTwoNumbers(LinkedList<int> l1, LinkedList<int> l2)
        {
            var result = new LinkedList<int>();
            var n1 = l1.First;
            var n2 = l2.First;
            int carry = 0;

            while (n1 != null || n2 != null || carry != 0)
            {
                int sum = (n1?.Value ?? 0) + (n2?.Value ?? 0) + carry;
                carry = sum / 10;
                result.AddLast(sum % 10);
                n1 = n1?.Next;
                n2 = n2?.Next;
            }

            return result;
        }

        static void Main(string[] args)
        {
            Console.WriteLine("── Custom ListNode ──");
            // Example 1: 342 + 465 = 807 → [7,0,8]
            Print(AddTwoNumbers(
                new ListNode(2, new ListNode(4, new ListNode(3))),
                new ListNode(5, new ListNode(6, new ListNode(4)))));

            // Example 2: 0 + 0 = 0 → [0]
            Print(AddTwoNumbers(new ListNode(0), new ListNode(0)));

            // Example 3: 9999999 + 9999 → [8,9,9,9,0,0,0,1]
            Print(AddTwoNumbers(
                new ListNode(9, new ListNode(9, new ListNode(9, new ListNode(9, new ListNode(9, new ListNode(9, new ListNode(9))))))),
                new ListNode(9, new ListNode(9, new ListNode(9, new ListNode(9))))));

            Console.WriteLine("\n── Built-in LinkedList<T> ──");
            // Example 1
            Console.WriteLine(string.Join(",", AddTwoNumbers(
                new LinkedList<int>(new[] { 2, 4, 3 }),
                new LinkedList<int>(new[] { 5, 6, 4 }))));

            // Example 2
            Console.WriteLine(string.Join(",", AddTwoNumbers(
                new LinkedList<int>(new[] { 0 }),
                new LinkedList<int>(new[] { 0 }))));

            // Example 3
            Console.WriteLine(string.Join(",", AddTwoNumbers(
                new LinkedList<int>(new[] { 9, 9, 9, 9, 9, 9, 9 }),
                new LinkedList<int>(new[] { 9, 9, 9, 9 }))));
        }
    }
