namespace ConsoleApp6Test
{
    internal class Program
    {
        static LinkedList<int> AddTwoNumbers(LinkedList<int> l1, LinkedList<int> l2)
        {
            var result = new LinkedList<int>();
            var n1 = l1.First;
            var n2 = l2.First;
            int carry = 0;

            while (n1 != null || n2 != null || carry != 0)
            {
                int sum = (n1?.Value ?? 0) + (n2?.Value ?? 0) + carry;
                carry = sum / 10;
                result.AddLast(sum % 10);
                n1 = n1?.Next;
                n2 = n2?.Next;
            }

            return result;
        }

        static void Main(string[] args)
        {
            // Example 1: 342 + 465 = 807 → [7,0,8]
            Console.WriteLine(string.Join(",", AddTwoNumbers(
                new LinkedList<int>(new[] { 2, 4, 3 }),
                new LinkedList<int>(new[] { 5, 6, 4 }))));

            // Example 2: 0 + 0 = 0 → [0]
            Console.WriteLine(string.Join(",", AddTwoNumbers(
                new LinkedList<int>(new[] { 0 }),
                new LinkedList<int>(new[] { 0 }))));

            // Example 3: 9999999 + 9999 → [8,9,9,9,0,0,0,1]
            Console.WriteLine(string.Join(",", AddTwoNumbers(
                new LinkedList<int>(new[] { 9, 9, 9, 9, 9, 9, 9 }),
                new LinkedList<int>(new[] { 9, 9, 9, 9 }))));
        }
    }
}
